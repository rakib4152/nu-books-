# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (Hostinger Business Shared MySQL)
DATABASE_URL="mysql://u123456789_admin:YourStrongPassword123!@localhost:3306/u123456789_foliopress"

# Authentication & Session Security
SESSION_SECRET="generate_a_random_32_byte_secret_key_here"
AUTH_ALLOWED_ORIGINS="https://admin.foliopress.io,http://localhost:3000"

# Service URLs
API_BASE_URL="https://api.foliopress.io/api/v1"
ADMIN_APP_URL="https://admin.foliopress.io"

# Private PDF Object Storage (Cloudflare R2 / S3-compatible)
PDF_STORAGE_PROVIDER="cloudflare_r2"
PDF_STORAGE_BUCKET="foliopress-private-vault"
PDF_STORAGE_ACCESS_KEY="your_r2_access_key_id"
PDF_STORAGE_SECRET_KEY="your_r2_secret_access_key"

# Hostinger Node.js Prisma Daemon & PDF Processing Service Bridge
PDF_PROCESSOR_URL="https://hostinger-prisma.foliopress.internal"
PDF_PROCESSOR_SECRET="mutual_pre_shared_secret_between_worker_and_hostinger_service"
DB_SERVICE_URL="https://hostinger-prisma.foliopress.internal"
DB_SERVICE_SECRET="mutual_pre_shared_secret_between_worker_and_hostinger_service"
